# Copia este archivo a .env y completa los valores marcados con <...>. No subas .env a git.

PORT=8084
# Perfil "local" (local/start-all.ps1): DB_URL/DB_USERNAME/DB_PASSWORD; si faltan usa localhost.
# Cualquier otro entorno (sin perfil local) usa DATABASE_URL/DATABASE_USERNAME/DATABASE_PASSWORD, obligatorias:
# DATABASE_URL=jdbc:postgresql://<host>:5432/<db>
# DATABASE_USERNAME=<usuario>
# DATABASE_PASSWORD=<password>

DB_USERNAME=postgres
DB_PASSWORD=password
DB_POOL_SIZE=4
JWT_SECRET=<jwt_secret>
JWT_EXPIRATION_DAYS=365
PAYMENT_GATEWAY_PROVIDER=culqi
CULQI_SECRET_KEY=<culqi_secret_key>
CORS_ALLOWED_ORIGINS=http://localhost:4200
UNITS_SERVICE_URL=http://localhost:8082

# Llave publica de Culqi (pk_test_... / pk_live_...): solo para clientes que tokenizan tarjetas. Nunca la secreta en el cliente.
CULQI_PUBLIC_KEY=
